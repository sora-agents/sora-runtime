# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/

# Virtual environments
.venv/
venv/

# Testing & coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# Type checking / linting caches
.mypy_cache/
.ruff_cache/
.dmypy.json

# S-ORA runtime state (e.g. file-backed semantic/procedural/episodic memory stores) —
# namespaced under .sora/ to avoid colliding with unrelated "memory" conventions
.sora/
my-agent/
logs/

# Gaia2 scenario JSON fetched from HuggingFace (examples/gaia2/scripts/fetch_scenario.py) —
# Meta's dataset content, gated by the HF dataset terms; fetch on demand, don't redistribute.
# The directory is ignored wholesale, not just the *.scenario.json naming: a scenario keeps its
# own upstream filename (scenario_universe_21_5e0gvz.json) when fetched by id, which no suffix
# pattern catches, and 12 MB of it was already sitting untracked in a working tree.
scenario.json
*.scenario.json
examples/gaia2/scenarios/

# Environment
.env
.env.*
# keep the committed template (real secrets go in the ignored .env)
!.env.example

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Claude Code local session/config
.claude/

# Documentation
site/
