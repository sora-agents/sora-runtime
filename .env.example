# Copy this file to `.env` and fill in your values.
#
# `.env` is gitignored and loaded automatically when present (see `build_agent` in sora/bootstrap.py).
# Real environment variables take precedence — a value here is only used when the variable is not
# already set. Never commit real secrets; keep them in `.env` (ignored) or a secrets manager.

# Anthropic API key for the default model-backed Reason strategy (requires the `[llm]` extra).
# Get one at https://console.anthropic.com/ — or run `ant auth login` instead of setting a key here.
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI proper uses the SDK-standard variable automatically when no custom base_url is configured.
# OPENAI_API_KEY=sk-...

# A hosted OpenAI-compatible endpoint selects its own key by naming this variable through
# agent.llm.api_key_env. The variable name is config; its value remains only in the environment.
# OPENROUTER_API_KEY=sk-or-v1-...

# Path to a local gaia2-cli checkout (Meta's containerised Gaia2 harness). Only the `side_effecting`
# drift guard in tests/test_gaia2_cli_adapter.py reads it: the adapter infers whether a CLI command
# writes, and the guard cross-checks that inference against upstream's own `log_action(..., write=)`
# sites — which ship as source, not in the container image. Unset, that one test skips.
# SORA_GAIA2_CLI_DIR=/path/to/meta-agents-research-environments/gaia2-cli
